{
  "name": "codementor-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "pnpm --filter @codementor/client dev",
    "dev:lecturer": "pnpm --filter @codementor/lecturer dev",
    "dev:admin": "pnpm --filter @codementor/admin dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@codementor/eslint-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "next": "16.2.12",
    "turbo": "^2.5.8",
    "typescript": "^5"
  }
}
