# Public browser-safe configuration only. Do not put client secrets in this file.
# Copy to .env.local. Values below are the shared development stack.

# The Kong gateway, not a service port. Routing lives in codementor-backend/kong/kong.yml.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Keycloak public client, PKCE S256, redirect http://localhost:3010/*
NEXT_PUBLIC_KEYCLOAK_URL=https://id.codementor.cloud
NEXT_PUBLIC_KEYCLOAK_REALM=codementor
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=codementor-lecturer

# Trang client, dùng để dựng link "xem bài viết trên trang người học". Có giá trị mặc định
# là http://localhost:3000 trong code, nên chỉ cần đặt khi client chạy ở nơi khác.
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
