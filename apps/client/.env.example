# Public browser-safe configuration only. Do not put client secrets in this file.
# Copy to .env.local. Values below are the shared development stack.

# Kong gateway, not a service port directly — same origin lecturer/admin use.
# Routing lives in codementor-backend/kong/kong.yml.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Keycloak public client, PKCE S256.
NEXT_PUBLIC_KEYCLOAK_URL=https://id.codementor.cloud
NEXT_PUBLIC_KEYCLOAK_REALM=codementor
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=codementor-web

# --- Server-only. Never rename these with a NEXT_PUBLIC_ prefix: that inlines them
# --- into the browser bundle, which for a client secret means publishing it.

# Keycloak as reached from the Next.js server (may be an internal address).
KEYCLOAK_INTERNAL_URL=https://id.codementor.cloud
KEYCLOAK_REALM=codementor

# Confidential client used ONLY by the BFF for username/password login. Its secret is
# written to codementor-infra/docker/.env as KEYCLOAK_WEB_BFF_CLIENT_SECRET by
# scripts/configure-codementor-realm.sh — copy the value here.
KEYCLOAK_BFF_CLIENT_ID=codementor-web-bff
KEYCLOAK_BFF_CLIENT_SECRET=
KEYCLOAK_API_AUDIENCE=codementor-api

# Encrypts the session cookie. Unique per environment, at least 32 characters.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
# true in production: the session cookie is then refused over plain HTTP.
AUTH_COOKIE_SECURE=false

# Gateway address used by the /api/backend proxy (server-to-server).
API_INTERNAL_URL=http://localhost:8000/api/v1

# realtime-service (WebSocket). Gọi thẳng, không qua Kong — xem ghi chú ở lib/env.ts.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3009

# Chỉ phía server: tầng Node của Lecter (`/api/copilotkit`) gọi ai-service qua địa chỉ này.
# KHÔNG có tiền tố NEXT_PUBLIC_. Bỏ trống thì rơi về API_INTERNAL_URL rồi
# NEXT_PUBLIC_API_BASE_URL — đúng trên máy dev, thường sai khi Next chạy trong container.
AI_SERVICE_URL=http://localhost:8000/api/v1
