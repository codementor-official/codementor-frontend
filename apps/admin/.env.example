# Server-only BFF configuration. Generate a unique session secret per environment.
#
# auth-config.ts also reads NEXT_PUBLIC_KEYCLOAK_URL / _REALM / _CLIENT_ID and
# NEXT_PUBLIC_API_BASE_URL as last-resort fallbacks. They are left out of this file on
# purpose: admin authenticates through the BFF, so the browser never needs Keycloak
# config, and a NEXT_PUBLIC_ name is inlined into the client bundle. Set the server-only
# names below instead — the fallbacks exist for shared dev stacks, not for this app.
# Kong gateway kèm tiền tố phiên bản, giống apps/client.
# Trỏ thẳng vào core-service (:3001/api) là sai hai lần: thiếu đoạn `/v1` mà mọi
# controller đều khai báo, và core không sở hữu exercises/courses/roadmaps — chỉ
# gateway mới định tuyến được sang đúng service.
API_INTERNAL_URL=http://localhost:8000/api/v1
KEYCLOAK_INTERNAL_URL=https://id.codementor.cloud
KEYCLOAK_REALM=codementor
KEYCLOAK_CLIENT_ID=codementor-admin
KEYCLOAK_BFF_CLIENT_ID=codementor-web-bff
KEYCLOAK_BFF_CLIENT_SECRET=replace-with-confidential-keycloak-client-secret
KEYCLOAK_API_AUDIENCE=codementor-api
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=false

# Trang client, dùng để dựng link "xem bài viết trên trang người học". Có giá trị mặc định
# là http://localhost:3000 trong code, nên chỉ cần đặt khi client chạy ở nơi khác.
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# realtime-service (WebSocket) cho chuông thông báo trên thanh trên cùng. Gọi thẳng, không qua
# Kong. Mặc định trong code là http://localhost:3009, nên thiếu biến này thì bản triển khai
# thật vẫn build xanh rồi lặng lẽ mở WebSocket về localhost của người dùng.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3009
