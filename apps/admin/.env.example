# Server-only BFF configuration. Generate a unique session secret per environment.
# Kong gateway kèm tiền tố phiên bản, giống apps/client.
# Trỏ thẳng vào core-service (:3001/api) là sai hai lần: thiếu đoạn `/v1` mà mọi
# controller đều khai báo, và core không sở hữu exercises/courses/roadmaps — chỉ
# gateway mới định tuyến được sang đúng service.
API_INTERNAL_URL=http://localhost:8000/api/v1
KEYCLOAK_INTERNAL_URL=https://id.codementor.cloud
KEYCLOAK_REALM=codementor
KEYCLOAK_CLIENT_ID=codementor-admin
KEYCLOAK_API_AUDIENCE=codementor-api
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=false
